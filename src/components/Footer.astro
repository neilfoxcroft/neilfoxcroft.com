---
// Full-width footer under both columns: short labelled credits instead of one long sentence.
// A link with a `logo` (an SVG path on a 24 × 24 grid) shows the logo instead of the label, in the same colours
// as the other footer links; the label is still its accessible name.
type Link = { label: string; href: string; logo?: string };

// Claude's mark, from Simple Icons (simpleicons.org).
const claudeLogo =
  'm4.7144 15.9555 4.7174-2.6471.079-.2307-.079-.1275h-.2307l-.7893-.0486-2.6956-.0729-2.3375-.0971-2.2646-.1214-.5707-.1215-.5343-.7042.0546-.3522.4797-.3218.686.0608 1.5179.1032 2.2767.1578 1.6514.0972 2.4468.255h.3886l.0546-.1579-.1336-.0971-.1032-.0972L6.973 9.8356l-2.55-1.6879-1.3356-.9714-.7225-.4918-.3643-.4614-.1578-1.0078.6557-.7225.8803.0607.2246.0607.8925.686 1.9064 1.4754 2.4893 1.8336.3643.3035.1457-.1032.0182-.0728-.164-.2733-1.3539-2.4467-1.445-2.4893-.6435-1.032-.17-.6194c-.0607-.255-.1032-.4674-.1032-.7285L6.287.1335 6.6997 0l.9957.1336.419.3642.6192 1.4147 1.0018 2.2282 1.5543 3.0296.4553.8985.2429.8318.091.255h.1579v-.1457l.1275-1.706.2368-2.0947.2307-2.6957.0789-.7589.3764-.9107.7468-.4918.5828.2793.4797.686-.0668.4433-.2853 1.8517-.5586 2.9021-.3643 1.9429h.2125l.2429-.2429.9835-1.3053 1.6514-2.0643.7286-.8196.85-.9046.5464-.4311h1.0321l.759 1.1293-.34 1.1657-1.0625 1.3478-.8804 1.1414-1.2628 1.7-.7893 1.36.0729.1093.1882-.0183 2.8535-.607 1.5421-.2794 1.8396-.3157.8318.3886.091.3946-.3278.8075-1.967.4857-2.3072.4614-3.4364.8136-.0425.0304.0486.0607 1.5482.1457.6618.0364h1.621l3.0175.2247.7892.522.4736.6376-.079.4857-1.2142.6193-1.6393-.3886-3.825-.9107-1.3113-.3279h-.1822v.1093l1.0929 1.0686 2.0035 1.8092 2.5075 2.3314.1275.5768-.3218.4554-.34-.0486-2.2039-1.6575-.85-.7468-1.9246-1.621h-.1275v.17l.4432.6496 2.3436 3.5214.1214 1.0807-.17.3521-.6071.2125-.6679-.1214-1.3721-1.9246L14.38 17.959l-1.1414-1.9428-.1397.079-.674 7.2552-.3156.3703-.7286.2793-.6071-.4614-.3218-.7468.3218-1.4753.3886-1.9246.3157-1.53.2853-1.9004.17-.6314-.0121-.0425-.1397.0182-1.4328 1.9672-2.1796 2.9446-1.7243 1.8456-.4128.164-.7164-.3704.0667-.6618.4008-.5889 2.386-3.0357 1.4389-1.882.929-1.0868-.0062-.1579h-.0546l-6.3385 4.1164-1.1293.1457-.4857-.4554.0608-.7467.2307-.2429 1.9064-1.3114Z';
const items: { label: string; links: Link[]; after?: string }[] = [
  {
    label: 'built with',
    links: [
      { label: 'Astro', href: 'https://astro.build' },
      { label: 'Tailwind CSS', href: 'https://tailwindcss.com' },
    ],
    after: '· AWS',
  },
  { label: 'source', links: [{ label: 'GitHub', href: 'https://github.com/neilfoxcroft/neilfoxcroft.com' }] },
  { label: 'inspired by', links: [{ label: 'Brittany Chiang', href: 'https://brittanychiang.com' }] },
  { label: 'colours', links: [{ label: 'Catppuccin', href: 'https://catppuccin.com' }] },
  {
    label: 'with help from',
    links: [
      { label: 'Claude', href: 'https://claude.com/claude-code', logo: claudeLogo },
    ],
  },
];
---

<footer class="relative mx-auto max-w-[1180px] px-5 pb-8 md:px-12">
  <ul class="m-0 flex list-none flex-col gap-0 border-t border-line p-0 pt-4 text-[0.72rem] sm:flex-row sm:flex-wrap sm:gap-x-7 sm:gap-y-0.5 xl:flex-nowrap xl:justify-between xl:gap-x-4">
    {
      items.map((item) => (
        <li class="whitespace-nowrap text-muted">
          <span class="text-accent">//</span> {item.label}{' '}
          {item.links.map((l, i) => (
            <>
              {i > 0 && ', '}
              {l.logo ? (
                <a
                  href={l.href}
                  target="_blank"
                  rel="noopener"
                  aria-label={l.label}
                  title={l.label}
                  class="inline-block py-1 text-text hover:text-accent"
                >
                  {/* Sits on the text baseline (like a letter), so this item lines up with the others. */}
                  <svg viewBox="0 0 24 24" aria-hidden="true" class="inline-block size-[1.15em] align-[-0.2em]" fill="currentColor">
                    <path d={l.logo} />
                  </svg>
                </a>
              ) : (
                <a href={l.href} target="_blank" rel="noopener" class="inline-block py-1 text-text hover:text-accent">
                  {l.label}
                </a>
              )}
            </>
          ))}
          {item.after && <> {item.after}</>}
        </li>
      ))
    }
    {/*
      Light / dark switch, the last item on the line, styled like the other footer links. It names the theme it
      switches to; both labels are in the markup and CSS shows the right one (global.css), so nothing flickers
      while the page loads. The choice is saved and applied before paint by Base.astro.
    */}
    <li class="whitespace-nowrap text-muted">
      <span class="text-accent">//</span> theme{' '}
      <button
        type="button"
        data-theme-toggle
        class="inline-block cursor-pointer py-1 text-text transition-colors hover:text-accent"
      >
        <span data-theme-show="dark">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="inline-block size-[1em] align-[-0.125em]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>{' '}
          light
        </span>
        <span data-theme-show="light">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="inline-block size-[1em] align-[-0.125em]" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
            <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z"></path>
          </svg>{' '}
          dark
        </span>
      </button>
    </li>
  </ul>
</footer>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const isLight = () => document.documentElement.dataset.theme === 'light';
  const render = () => {
    toggle?.setAttribute('aria-pressed', String(isLight()));
    toggle?.setAttribute('aria-label', `Switch to ${isLight() ? 'dark' : 'light'} mode`);
    document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')?.setAttribute('content', isLight() ? '#eff1f5' : '#1e1e2e');
  };
  toggle?.addEventListener('click', () => {
    if (isLight()) delete document.documentElement.dataset.theme;
    else document.documentElement.dataset.theme = 'light';
    try {
      localStorage.setItem('theme', isLight() ? 'light' : 'dark');
    } catch {
      // Storage can be unavailable (private mode); the switch still works for this visit.
    }
    render();
    document.dispatchEvent(new CustomEvent('themechange'));
  });
  render();
</script>
