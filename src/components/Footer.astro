---
// Full-width footer under both columns: short labelled credits instead of one long sentence.
type Link = { label: string; href: string };
const items: { label: string; links: Link[]; after?: string }[] = [
  {
    label: 'built with',
    links: [
      { label: 'Astro', href: 'https://astro.build' },
      { label: 'Tailwind CSS', href: 'https://tailwindcss.com' },
    ],
    after: '· AWS',
  },
  { label: 'source', links: [{ label: 'GitHub', href: 'https://github.com/neilfoxcroft/neilfoxcroft.com-repo' }] },
  { label: 'inspired by', links: [{ label: 'Brittany Chiang', href: 'https://brittanychiang.com' }] },
  { label: 'colours', links: [{ label: 'Catppuccin Mocha', href: 'https://catppuccin.com' }] },
  { label: 'with help from', links: [{ label: 'Claude', href: 'https://claude.com/claude-code' }] },
];
---

<footer class="relative mx-auto max-w-[1180px] px-5 pb-10 md:px-12">
  <ul class="m-0 flex list-none flex-col gap-0 border-t border-line p-0 pt-6 text-[0.8rem] sm:flex-row sm:flex-wrap sm:gap-x-8 sm:gap-y-1 xl:flex-nowrap xl:justify-between xl:gap-x-4">
    {
      items.map((item) => (
        <li class="whitespace-nowrap text-muted">
          <span class="text-accent">//</span> {item.label}{' '}
          {item.links.map((l, i) => (
            <>
              {i > 0 && ', '}
              <a href={l.href} target="_blank" rel="noopener" class="inline-block py-1 text-text hover:text-accent">
                {l.label}
              </a>
            </>
          ))}
          {item.after && <> {item.after}</>}
        </li>
      ))
    }
  </ul>
</footer>
