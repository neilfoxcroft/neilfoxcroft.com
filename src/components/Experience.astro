---
import SectionLabel from './SectionLabel.astro';
import Tags from './Tags.astro';
import resume from '../data/resume.json';
import { dateRange } from '../lib/format';
import { TRAIL_PERIOD, TRAIL_TRACK, trailMask } from '../lib/trail-line';

// The timeline line is a gently meandering trail: a repeating SVG tile used as a mask over the track.
const trailStyle = `mask-image:${trailMask()};mask-size:${TRAIL_TRACK}px ${TRAIL_PERIOD}px;mask-repeat:repeat-y`;
---

<section id="experience" aria-label="Experience" class="flex scroll-mt-24 flex-col gap-6">
  <SectionLabel text="experience" />

  {
    resume.work.map((job) => (
      <div class="flex flex-col gap-6">
        <div class="flex flex-col gap-2">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <div class="flex flex-col gap-1">
              <h3 class="m-0 text-[1.4rem] font-bold tracking-tight text-heading">
                <a href={job.url} target="_blank" rel="noopener" class="-my-1 inline-block py-1 text-heading hover:text-accent">
                  {job.name} <span aria-hidden="true" class="text-[1rem] text-muted">↗</span>
                </a>
              </h3>
              <p class="m-0 font-medium text-accent">{job.position}</p>
            </div>
            <p class="m-0 text-[0.8rem] tracking-[0.04em] text-muted">{dateRange(job.startDate)}</p>
          </div>
          <p class="m-0 text-[0.9rem]">{job.summary}</p>
        </div>

        {/*
          Scroll timeline. The script below sets --xp (0 to 1) on the track as you scroll through it; the
          gradient fill's height follows it along the trail, and each entry's dot gets data-reached once the
          fill passes it. The script also shifts the glowing head (--head-x) and the dots (--dx) sideways so they
          sit on the trail's bends.
        */}
        <div data-timeline class="relative flex gap-5 [--xp:0] sm:gap-8">
          <div aria-hidden="true" data-track class="relative w-[14px] shrink-0">
            <div class="absolute inset-0 bg-line" style={trailStyle}>
              <div class="absolute inset-x-0 top-0 h-[calc(var(--xp)*100%)] bg-linear-to-b from-accent via-blue via-55% to-teal" />
            </div>
            <span
              data-trail-head
              class="absolute top-[calc(var(--xp)*100%)] left-1/2 size-[11px] translate-x-[calc(-50%_+_var(--head-x,0px))] -translate-y-1/2 rounded-full bg-teal shadow-[0_0_0_4px_rgb(148_226_213/0.18),0_0_16px_rgb(148_226_213/0.6)]"
            />
          </div>
          <ol class="flex min-w-0 flex-1 flex-col gap-4">
            {job.engagements.map((e) => (
              <li class="group relative flex flex-col gap-2 rounded-[10px] border border-transparent py-3 transition-colors lg:p-5 lg:hover:border-line lg:hover:bg-heading/[0.035]">
                <span
                  aria-hidden="true"
                  data-dot
                  class="absolute top-[1.15rem] -left-[calc(1.25rem+12.5px)] size-[9px] translate-x-(--dx) rounded-full bg-line-strong ring-3 ring-bg transition-colors duration-300 [--dx:0px] data-reached:bg-heading sm:-left-[calc(2rem+12.5px)] lg:top-[1.9rem] motion-reduce:transition-none"
                />
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h4 class="m-0 text-[1.05rem] leading-snug font-semibold text-heading">
                    {e.url ? (
                      <a href={e.url} target="_blank" rel="noopener" class="-my-1 inline-block py-1 text-heading group-hover:text-accent">
                        {e.name} <span aria-hidden="true">↗</span>
                      </a>
                    ) : (
                      <span class="transition-colors group-hover:text-accent">{e.name}</span>
                    )}
                  </h4>
                  <p class="m-0 text-[0.8rem] tracking-[0.04em] text-muted">{dateRange(e.startDate, e.endDate)}</p>
                </div>
                <p class="m-0 text-[0.8rem] text-muted">
                  {e.type} · {e.description}
                </p>
                <p class="m-0 text-[0.9rem]">{e.summary}</p>
                <Tags items={e.keywords} />
              </li>
            ))}
          </ol>
        </div>
      </div>
    ))
  }

  <a
    href={resume.basics.resumeUrl}
    target="_blank"
    rel="noopener"
    class="inline-flex min-h-[44px] items-center gap-1 self-start font-semibold text-heading"
  >
    view full résumé <span aria-hidden="true" class="text-accent">↗</span>
  </a>
</section>

<script>
  import { trailX } from '../lib/trail-line';

  // Fills the timeline as the section scrolls past 60% of the screen height.
  // With "reduce motion" switched on, the timeline is simply shown full.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const timelines = document.querySelectorAll<HTMLElement>('[data-timeline]');
  let ticking = false;

  function update() {
    ticking = false;
    const line = window.innerHeight * 0.6;
    timelines.forEach((tl) => {
      const box = tl.getBoundingClientRect();
      const xp = reduceMotion.matches ? 1 : Math.min(1, Math.max(0, (line - box.top) / box.height));
      tl.style.setProperty('--xp', xp.toFixed(4));
      // The head follows the trail's bends at the fill height.
      tl.style.setProperty('--head-x', `${trailX(xp * box.height).toFixed(2)}px`);
      tl.querySelectorAll<HTMLElement>('[data-dot]').forEach((dot) => {
        const d = dot.getBoundingClientRect();
        const y = d.top + d.height / 2 - box.top;
        dot.style.setProperty('--dx', `${trailX(y).toFixed(2)}px`);
        dot.toggleAttribute('data-reached', xp > 0 && y / box.height <= xp);
      });
    });
  }

  function onScroll() {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  reduceMotion.addEventListener('change', update);
  update();
</script>
