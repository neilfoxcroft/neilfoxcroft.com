---
import SectionLabel from './SectionLabel.astro';
import Tags from './Tags.astro';
import Icon from './Icon.astro';
import resume from '../data/resume.json';
---

<section id="projects" aria-label="Projects" class="flex scroll-mt-24 flex-col gap-2">
  <SectionLabel text="projects" />
  {/*
    Each card shows the date and type, the name, a one-sentence summary and the technologies. Clicking it opens a
    <dialog> with the full description and the links. Esc, the close button or a click outside closes it.
  */}
  <ul class="flex flex-col gap-2">
    {
      resume.projects.map((p, i) => (
        <li
          id={p.id}
          class="group flex scroll-mt-24 cursor-pointer flex-col gap-x-6 gap-y-2 rounded-[10px] border border-transparent py-3 transition-colors sm:flex-row lg:-mx-5 lg:p-5 lg:hover:border-line lg:hover:bg-heading/[0.035]"
        >
          <p class="m-0 flex shrink-0 flex-col text-[0.8rem] tracking-[0.04em] text-muted sm:mt-0.5 sm:w-[8.5rem]">
            <span>{p.date}</span>
            <span>{p.kind}</span>
          </p>
          <div class="flex min-w-0 flex-1 flex-col gap-2">
            <h3 class="m-0 flex items-start justify-between gap-4 text-[1rem] leading-snug font-semibold">
              {/* The name is the button (for the keyboard); a click anywhere on the card opens it too. */}
              <button
                type="button"
                data-project-open={i}
                aria-haspopup="dialog"
                class="cursor-pointer text-left text-heading transition-colors group-hover:text-accent"
              >
                {p.name}
                <span class="sr-only">(show details)</span>
              </button>
              <span
                aria-hidden="true"
                class="flex size-6 shrink-0 items-center justify-center rounded-full bg-accent/12 text-accent transition-colors group-hover:bg-accent/25"
              >
                +
              </span>
            </h3>
            <p class="m-0 text-[0.9rem]">{p.summary}</p>
            <Tags items={p.keywords} />
          </div>

          <dialog
            data-project-dialog={i}
            aria-labelledby={`project-title-${i}`}
            class="m-auto max-h-[calc(100dvh-2rem)] w-[min(40rem,calc(100vw-2rem))] overflow-y-auto rounded-[14px] border border-line bg-mantle p-0 text-text shadow-[0_30px_80px_rgb(0_0_0/0.6)] backdrop:bg-crust/70 backdrop:backdrop-blur-sm"
          >
            <div class="flex flex-col gap-2 p-6">
              <div class="flex items-start justify-between gap-4">
                <p class="m-0 text-[0.8rem] text-muted">
                  <span class="text-accent">//</span> {p.date} · {p.kind}
                </p>
                <button
                  type="button"
                  data-project-close
                  aria-label="Close"
                  class="-mt-2 -mr-2 flex size-[44px] shrink-0 cursor-pointer items-center justify-center rounded-md text-muted hover:text-accent"
                >
                  ✕
                </button>
              </div>
              <h3 id={`project-title-${i}`} class="m-0 text-[1.15rem] font-semibold text-heading">
                {p.name}
              </h3>
              <p class="m-0 mt-2 text-[0.9rem]">{p.description}</p>
              <Tags items={p.keywords} />
              {'links' in p && p.links && (
                <ul class="m-0 mt-3 flex list-none flex-wrap gap-x-5 p-0 text-[0.85rem]">
                  {p.links.map((l) => (
                    <li>
                      <a href={l.href} target="_blank" rel="noopener" class="inline-flex min-h-[44px] items-center gap-1.5 font-semibold">
                        {l.icon && <Icon name={l.icon as 'github' | 'youtube'} size={16} />}
                        {l.label} <span aria-hidden="true" class="text-accent">↗</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </dialog>
        </li>
      ))
    }
  </ul>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-project-open]').forEach((button) => {
    const dialog = document.querySelector<HTMLDialogElement>(`[data-project-dialog="${button.dataset.projectOpen}"]`);
    const card = button.closest('li');
    if (!dialog || !card) return;
    // The dialog sits inside the card, so clicks in it bubble up here too; those must not reopen it.
    card.addEventListener('click', (e) => {
      if (!(e.target instanceof Element && e.target.closest('dialog'))) dialog.showModal();
    });
    dialog.querySelector('[data-project-close]')?.addEventListener('click', () => dialog.close());
    // A click on the backdrop lands on the <dialog> element itself, not its content.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  });
</script>
