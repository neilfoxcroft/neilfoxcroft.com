---
// km / mi switch: a single button. At rest it's a faint round globe. On hover (or keyboard focus) it grows
// leftwards into a pill showing "🌐 km │ 🇺🇸 mi", with a mauve highlight behind the active unit. A click
// anywhere on it switches units and the highlight slides across. On touch screens a tap expands it briefly.
//
// The chosen units live on <html data-units="…"> (set before first paint in Base.astro and remembered in
// localStorage); elements marked data-unit="metric" / "imperial" are shown or hidden by CSS in global.css,
// which also moves the highlight ([data-units-thumb]), so everything follows the switch without re-rendering.
// Icons are drawn SVGs (flag emoji don't render on Windows); the flag is a placeholder.
const globePath =
  'M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z';
---

<button
  type="button"
  data-units-toggle
  class="group flex h-9 cursor-pointer items-center rounded-full border border-line bg-mantle/80 text-[0.8rem] text-muted opacity-50 backdrop-blur-sm transition-opacity duration-300 hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 data-open:opacity-100 motion-reduce:transition-none"
>
  {/* The two options; collapsed to zero width at rest, open on hover / focus / just tapped (data-open). */}
  <span
    class="max-w-0 overflow-hidden opacity-0 transition-all duration-300 ease-out group-hover:max-w-[10rem] group-hover:opacity-100 group-focus-visible:max-w-[10rem] group-focus-visible:opacity-100 group-data-open:max-w-[10rem] group-data-open:opacity-100 motion-reduce:transition-none"
  >
    <span class="relative flex p-0.5">
      {/* Sliding highlight behind the active unit (moved by global.css). */}
      <span
        data-units-thumb
        aria-hidden="true"
        class="absolute inset-y-0.5 left-0.5 w-[3.75rem] rounded-full bg-accent/15 transition-transform duration-300 ease-out motion-reduce:transition-none"
      >
      </span>
      <span data-unit-option="metric" class="relative flex h-8 w-[3.75rem] items-center justify-center gap-1.5">
        <svg
          aria-hidden="true"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <path d={globePath}></path>
        </svg>
        km
      </span>
      <span data-unit-option="imperial" class="relative flex h-8 w-[3.75rem] items-center justify-center gap-1.5">
        {/* Placeholder US flag: stripes and a blue canton. */}
        <svg aria-hidden="true" width="15" height="10" viewBox="0 0 19 13" class="rounded-[2px]">
          <rect width="19" height="13" fill="#cdd6f4"></rect>
          <path d="M0 0h19v1H0zM0 2h19v1H0zM0 4h19v1H0zM0 6h19v1H0zM0 8h19v1H0zM0 10h19v1H0zM0 12h19v1H0z" fill="#e64553"
          ></path>
          <rect width="8" height="7" fill="#89b4fa"></rect>
        </svg>
        mi
      </span>
    </span>
  </span>

  {/* Resting globe; shrinks away as the pill expands, so the right edge stays put. */}
  <span
    aria-hidden="true"
    class="flex w-[34px] shrink-0 items-center justify-center overflow-hidden transition-all duration-300 ease-out group-hover:w-0 group-hover:opacity-0 group-focus-visible:w-0 group-focus-visible:opacity-0 group-data-open:w-0 group-data-open:opacity-0 motion-reduce:transition-none"
  >
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="12" cy="12" r="10"></circle>
      <path d={globePath}></path>
    </svg>
  </span>
</button>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-units-toggle]');
  const current = () => (document.documentElement.dataset.units === 'imperial' ? 'imperial' : 'metric');
  const label = () => {
    const metric = current() === 'metric';
    toggle?.setAttribute(
      'aria-label',
      `Distance units: ${metric ? 'kilometres' : 'miles'}. Switch to ${metric ? 'miles' : 'kilometres'}.`,
    );
  };
  let hideTimer: number | undefined;
  toggle?.addEventListener('click', (e) => {
    const units = current() === 'metric' ? 'imperial' : 'metric';
    document.documentElement.dataset.units = units;
    try {
      localStorage.setItem('units', units);
    } catch {
      // Storage can be unavailable (private mode); the switch still works for this visit.
    }
    label();
    document.dispatchEvent(new CustomEvent('unitschange'));
    // Touch screens have no hover: keep the pill open briefly so the slide is visible, then shrink back.
    if ((e as PointerEvent).pointerType && (e as PointerEvent).pointerType !== 'mouse') {
      toggle.toggleAttribute('data-open', true);
      window.clearTimeout(hideTimer);
      hideTimer = window.setTimeout(() => toggle.removeAttribute('data-open'), 1500);
    }
  });
  label();
</script>
