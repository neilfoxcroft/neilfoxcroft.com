---
// km / mi switch: a single button. At rest it's a faint round icon for the active unit (globe for km, flag
// for mi). On hover (or keyboard focus) it grows leftwards into a pill showing "globe km │ flag mi", with a
// mauve highlight behind the active unit. A click anywhere on it switches units and the highlight slides
// across. On touch screens a tap expands it briefly.
//
// The chosen units live on <html data-units="…"> (set before first paint in Base.astro and remembered in
// localStorage); elements marked data-unit="metric" / "imperial" are shown or hidden by CSS in global.css,
// which also moves the highlight ([data-units-thumb]), so everything follows the switch without re-rendering.
// Icons are drawn SVGs (flag emoji don't render on Windows); both are placeholders for now.
const land =
  'M6.6 5.6c1.7-.9 3.6-.7 4.5.4.7.8.1 2-1 2.3-1.2.4-1.4 1.7-.6 2.5.9.9.2 2.5-1.2 2.4-1.6-.1-2.5-1.8-3.4-2.9-.9-1.2-.3-3.6 1.7-4.7zM14.6 11c1.6-.3 3.3.4 4 1.9.6 1.4-.1 3.1-1.4 3.7-1 .5-1.3 1.8-2.1 2.5-.9.7-2.2 0-2.2-1.1 0-1.3.6-2.3.3-3.5-.3-1.4.2-3.2 1.4-3.5z';
---

<button
  type="button"
  data-units-toggle
  class="group flex h-9 cursor-pointer items-center rounded-full border border-line bg-mantle/80 text-[0.8rem] text-muted opacity-50 backdrop-blur-sm transition-opacity duration-500 hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 data-open:opacity-100 motion-reduce:transition-none"
>
  {/* The two options; collapsed to zero width at rest, open on hover / focus / just tapped (data-open). */}
  <span
    class="max-w-0 overflow-hidden opacity-0 transition-all duration-500 ease-out group-hover:max-w-[10rem] group-hover:opacity-100 group-focus-visible:max-w-[10rem] group-focus-visible:opacity-100 group-data-open:max-w-[10rem] group-data-open:opacity-100 motion-reduce:transition-none"
  >
    <span class="relative flex p-0.5">
      {/* Sliding highlight behind the active unit (moved by global.css). */}
      <span
        data-units-thumb
        aria-hidden="true"
        class="absolute inset-y-0.5 left-0.5 w-[3.75rem] rounded-full bg-accent/15 transition-transform duration-400 ease-out motion-reduce:transition-none"
      >
      </span>
      <span data-unit-option="metric" class="relative flex h-8 w-[3.75rem] items-center justify-center gap-1.5">
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10" fill="#89b4fa"></circle>
          <path d={land} fill="#a6e3a1"></path>
        </svg>
        km
      </span>
      <span data-unit-option="imperial" class="relative flex h-8 w-[3.75rem] items-center justify-center gap-1.5">
        <svg aria-hidden="true" width="15" height="10" viewBox="0 0 19 13" class="rounded-[2px]">
          <rect width="19" height="13" fill="#cdd6f4"></rect>
          <path d="M0 0h19v1H0zM0 2h19v1H0zM0 4h19v1H0zM0 6h19v1H0zM0 8h19v1H0zM0 10h19v1H0zM0 12h19v1H0z" fill="#e64553"
          ></path>
          <rect width="8" height="7" fill="#89b4fa"></rect>
        </svg>
        mi
      </span>
    </span>
  </span>

  {/* Resting icon for the active unit; shrinks away as the pill expands, so the right edge stays put. */}
  <span
    aria-hidden="true"
    class="flex w-[34px] shrink-0 items-center justify-center overflow-hidden transition-all duration-500 ease-out group-hover:w-0 group-hover:opacity-0 group-focus-visible:w-0 group-focus-visible:opacity-0 group-data-open:w-0 group-data-open:opacity-0 motion-reduce:transition-none"
  >
    <svg data-unit="metric" width="18" height="18" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="10" fill="#89b4fa"></circle>
      <path d={land} fill="#a6e3a1"></path>
    </svg>
    <svg data-unit="imperial" width="19" height="13" viewBox="0 0 19 13" class="rounded-[2px]">
      <rect width="19" height="13" fill="#cdd6f4"></rect>
      <path d="M0 0h19v1H0zM0 2h19v1H0zM0 4h19v1H0zM0 6h19v1H0zM0 8h19v1H0zM0 10h19v1H0zM0 12h19v1H0z" fill="#e64553"
      ></path>
      <rect width="8" height="7" fill="#89b4fa"></rect>
    </svg>
  </span>
</button>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-units-toggle]');
  const current = () => (document.documentElement.dataset.units === 'imperial' ? 'imperial' : 'metric');
  const label = () => {
    const metric = current() === 'metric';
    toggle?.setAttribute(
      'aria-label',
      `Distance units: ${metric ? 'kilometres' : 'miles'}. Switch to ${metric ? 'miles' : 'kilometres'}.`,
    );
  };
  let hideTimer: number | undefined;
  toggle?.addEventListener('click', (e) => {
    const units = current() === 'metric' ? 'imperial' : 'metric';
    document.documentElement.dataset.units = units;
    try {
      localStorage.setItem('units', units);
    } catch {
      // Storage can be unavailable (private mode); the switch still works for this visit.
    }
    label();
    document.dispatchEvent(new CustomEvent('unitschange'));
    // Touch screens have no hover: keep the pill open briefly so the slide is visible, then shrink back.
    if ((e as PointerEvent).pointerType && (e as PointerEvent).pointerType !== 'mouse') {
      toggle.toggleAttribute('data-open', true);
      window.clearTimeout(hideTimer);
      hideTimer = window.setTimeout(() => toggle.removeAttribute('data-open'), 1500);
    }
  });
  label();
</script>
