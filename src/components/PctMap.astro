---
import { buildPctMap, WIDTH, HEIGHT } from '../lib/pct-map';

// All projection maths happens here at build time; the browser just gets the SVG.
const map = buildPctMap();
---

{/*
  The map is an SVG laid on a tilted plane: CSS perspective on the wrapper, then rotateX/rotateZ on the
  plane, with a darker slab pushed 18px behind it for depth. The tilt is gentler on phones.
  The negative margins take back the empty space the tilt leaves above and below.
  The route is drawn white. Moving the mouse anywhere over the map (or tapping it) colours it PCT teal from
  Campo up to the point on the trail nearest the cursor, and it stays coloured after the mouse leaves.
  data-samples holds evenly spaced points along the route; the script finds the nearest one and sets --done
  (0 to 1), which drives the coloured line's dash offset. Everything inside the SVG ignores the pointer, so the
  SVG itself gets every event and offsetX/offsetY are already mapped back through the 3D tilt by the browser.
*/}
<div class="flex min-w-0 flex-col items-center gap-2">
  <div id="pct-map" data-pct-map class="flex w-full justify-center perspective-[1600px]">
    <div
      data-pct-plane
      class="relative w-[80%] max-w-[380px] transform-3d transition-transform duration-300 ease-out [--hx:0] [--hy:0] -mt-[28px] [transform:translateX(-10px)_rotateX(35deg)_rotateZ(-8deg)] motion-reduce:transition-none md:mt-[-84px] md:w-[68%] md:mb-[-24px] md:[transform:translateX(-26px)_rotateY(calc(var(--hx)*6deg))_rotateX(calc(50deg_-_var(--hy)*6deg))_rotateZ(-22deg)]"
    >
      <div
        aria-hidden="true"
        class="absolute inset-0 rounded-[18px] bg-crust shadow-[0_40px_80px_rgb(0_0_0/0.55)] [transform:translateZ(-18px)]"
      >
      </div>
      <svg
        role="img"
        aria-labelledby="pct-map-title"
        viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
        data-samples={JSON.stringify(map.samples)}
        class="relative block h-auto w-full cursor-crosshair rounded-[18px] border border-line bg-mantle [&_*]:pointer-events-none"
      >
        <title id="pct-map-title">
          Map of the Pacific Crest Trail, running about 4,200 km from the Mexican border at Campo, California, north
          through Oregon and Washington to the Canadian border at Manning Park.
        </title>
        <defs>
          <filter id="pct-glow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="6"></feGaussianBlur>
          </filter>
        </defs>

        <path d={map.graticule} fill="none" stroke="#313244" stroke-width="1" opacity="0.6"></path>

        <g fill="#24273a" stroke="#45475a" stroke-width="1.5" stroke-linejoin="round">
          {map.countries.map((d) => <path d={d} />)}
          {map.contextStates.map((d) => <path d={d} />)}
        </g>
        <g fill="#313244" stroke="#6c7086" stroke-width="2" stroke-linejoin="round">
          {map.trailStates.map((d) => <path d={d} />)}
        </g>

        <g font-family="JetBrains Mono Variable, monospace" font-weight="600" text-anchor="middle" pointer-events="none">
          {
            map.stateLabels.map((l) => (
              <text x={l.x} y={l.y} font-size="22" letter-spacing="1.5" fill="#bac2de">
                {l.text}
              </text>
            ))
          }
          {
            map.countryLabels.map((l) => (
              <text x={l.x} y={l.y} font-size={l.size} letter-spacing="3" fill="#a6adc8">
                {l.text}
              </text>
            ))
          }
          <text
            x={map.ocean.x}
            y={map.ocean.y}
            font-size="22"
            letter-spacing="3"
            fill="#7f849c"
            transform={`rotate(-90 ${map.ocean.x} ${map.ocean.y})`}
          >
            PACIFIC OCEAN
          </text>
        </g>

        <g fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path d={map.trail} stroke="#cdd6f4" stroke-width="8" opacity="0.18" filter="url(#pct-glow)"></path>
          <path d={map.trail} stroke="#cdd6f4" stroke-width="3.5"></path>
          <g
            data-pct-done
            stroke="#038285"
            class="transition-[stroke-dashoffset] duration-150 ease-out [--done:0] [stroke-dashoffset:calc(1_-_var(--done))] motion-reduce:transition-none"
          >
            <path
              d={map.trail}
              stroke-width="10"
              opacity="0.6"
              filter="url(#pct-glow)"
              pathLength="1"
              stroke-dasharray="1"
              class="[stroke-dashoffset:inherit]"></path>
            <path d={map.trail} stroke-width="4.5" pathLength="1" stroke-dasharray="1" class="[stroke-dashoffset:inherit]"
            ></path>
          </g>
        </g>

        <circle cx={map.start.x} cy={map.start.y} r="8" fill="#1e1e2e" stroke="#cdd6f4" stroke-width="3" pointer-events="none"
        ></circle>
        <circle cx={map.end.x} cy={map.end.y} r="8" fill="#cdd6f4" stroke="#1e1e2e" stroke-width="3" pointer-events="none"
        ></circle>
      </svg>
    </div>
  </div>
  <p class="m-0 text-[0.8rem] text-muted">
    Trail data <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">{map.attribution}</a>
  </p>
</div>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const map = document.querySelector<HTMLElement>('[data-pct-map]');
  const plane = map?.querySelector<HTMLElement>('[data-pct-plane]');
  const done = map?.querySelector<SVGGElement>('[data-pct-done]');
  const svg = map?.querySelector<SVGSVGElement>('svg[data-samples]');
  const samples: number[] = JSON.parse(svg?.dataset.samples ?? '[]');
  const viewBox = svg?.viewBox.baseVal;

  // Colour the route from Campo up to the trail point nearest the pointer.
  function colourTo(e: PointerEvent) {
    if (!svg || !done || !viewBox || samples.length < 4) return;
    // offsetX/Y are in the SVG's own (untilted) CSS pixels; scale them to viewBox units.
    const x = (e.offsetX * viewBox.width) / svg.clientWidth;
    const y = (e.offsetY * viewBox.height) / svg.clientHeight;
    let best = 0;
    let bestD = Infinity;
    for (let i = 0; i < samples.length; i += 2) {
      const d = (samples[i] - x) ** 2 + (samples[i + 1] - y) ** 2;
      if (d < bestD) [bestD, best] = [d, i / 2];
    }
    done.style.setProperty('--done', (best / (samples.length / 2 - 1)).toFixed(4));
  }

  if (map && plane && svg) {
    svg.addEventListener('pointermove', colourTo);
    // Taps on touch screens colour the route too.
    svg.addEventListener('pointerdown', colourTo);

    // Hover tilt (mouse/trackpad only): the map leans a few degrees towards the cursor via --hx/--hy (-1 to 1).
    map.addEventListener('pointermove', (e) => {
      if (!finePointer.matches || reduceMotion.matches) return;
      const box = map.getBoundingClientRect();
      plane.style.setProperty('--hx', (((e.clientX - box.left) / box.width) * 2 - 1).toFixed(3));
      plane.style.setProperty('--hy', (((e.clientY - box.top) / box.height) * 2 - 1).toFixed(3));
    });
    // Leaving the map levels the tilt; the coloured trail stays where it was.
    map.addEventListener('pointerleave', () => {
      plane.style.setProperty('--hx', '0');
      plane.style.setProperty('--hy', '0');
    });
  }
</script>
