---
import SectionLabel from './SectionLabel.astro';
import PctMap from './PctMap.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import resume from '../data/resume.json';
import { buildPctMap } from '../lib/pct-map';
import { distance, distanceRange } from '../lib/format';
import { buildElevationProfile, PROFILE_W, PROFILE_H } from '../lib/pct-elevation';

const { pct } = resume;

// Photos live in src/assets/pct/ and are named by `image` in resume.json. Astro resizes them at build time
// into modern formats at a few sizes, and they load lazily as you scroll.
const photoFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/pct/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const { fractionAtPlace } = buildPctMap();
// One colour per section (Catppuccin Mocha), distinct from the white trail; End uses the PCT logo teal.
const sectionColours = ['#f38ba8', '#fab387', '#89dceb', '#a6e3a1', '#f9e2af', '#cba6f7', '#038285'];
const ends = pct.photos.map((ph) => fractionAtPlace(ph.endsAt.lonLat as [number, number]));
const profile = buildElevationProfile(fractionAtPlace);
// Where each section ends on the elevation profile (0–1 along the trail).
const profileEnds = pct.photos.map((ph) => profile.xOfPlace(ph.endsAt.lonLat as [number, number]));
const lastIndex = pct.photos.length - 1;
const photos = pct.photos.map((ph, i) => {
  const file = ph.image as string | null;
  const src = file ? photoFiles[`../assets/pct/${file}`]?.default : undefined;
  if (file && !src) throw new Error(`PCT photo "${file}" not found in src/assets/pct/`);
  const prev = pct.photos[i - 1];
  return {
    ...ph,
    src,
    // The slice of the map's route (0–1) this section covers: from the previous section's end to its own.
    // Start is the point at Campo (0–0); End is the whole trail.
    from: i === lastIndex ? 0 : (ends[i - 1] ?? 0),
    to: ends[i],
    // The same slice on the elevation profile, and the stretch this photo stands for in the "on screen" band
    // (Start and End are the two terminuses). The last section before End fills through to Manning Park: the
    // few kilometres past the Northern Terminus would otherwise show as an uncoloured sliver at the edge.
    pFrom: i === lastIndex ? 0 : (profileEnds[i - 1] ?? 0),
    pTo: i === lastIndex - 1 ? 1 : profileEnds[i],
    wFrom: i === lastIndex ? profileEnds[i - 1] : (profileEnds[i - 1] ?? 0),
    wTo: profileEnds[i],
    colour: sectionColours[i % sectionColours.length],
    // Start and End are single points (a terminus), so they show just the place; sections show from → to.
    // A section can name its start differently from where the previous one ended ("startsAt"), e.g. NorCal ends
    // at the Oregon border but Oregon starts at the California border.
    route:
      prev && ph.miles.length > 1
        ? `${('startsAt' in ph && ph.startsAt) || prev.endsAt.place} → ${ph.endsAt.place}`
        : ph.endsAt.place,
    // Section distance in both units; the km/mi switch decides which is shown.
    dist: { metric: distanceRange(ph.miles, 'metric'), imperial: distanceRange(ph.miles, 'imperial') },
  };
});
// Section boundaries drawn as faint ticks on the profile (between the sections, not at the two ends).
const profileTicks = profileEnds.slice(1, -2);---

<section id="pct" aria-label="Pacific Crest Trail" class="flex scroll-mt-24 flex-col gap-6">
  <SectionLabel text="pacific crest trail" />
  <div class="flex flex-col gap-3">
    <h3 class="m-0 text-[1.4rem] font-bold tracking-tight text-heading">{pct.heading}</h3>
    <p class="m-0 max-w-[40rem]">{pct.intro}</p>
  </div>

  <PctMap />

  {/*
    Elevation profile, then the photo strip, directly under the map so all three are on screen together:
    one photo per section, Campo north.
    Hovering, tapping or focusing a photo selects it: the map lights up just that section of the route in the
    section's colour (filling up from its start to its end), and the readout line below shows its details.
    The selection stays until another photo is selected or you click anywhere else on the page.
    Clicking a photo opens it full size in a <dialog>.
    Seven fit in one row on wide screens; on narrower ones the strip scrolls sideways.
  */}
  <div class="flex flex-col gap-2">
    {/*
      Elevation profile of the whole trail (Campo left, Manning Park right; NASA SRTM, shape only).
      - The selected photo's section fills in its colour, in step with the map.
      - Dragging or hovering along it moves a marker, traces the map up to that point and shows the mile and
        elevation in the readout. On touch it doesn't scroll the page (touch-action: none).
      - On phones a soft band marks the stretch covered by the photos currently on screen.
      The SVGs stretch to the box (preserveAspectRatio="none"); lines keep their width (non-scaling-stroke).
    */}
    <div class="mt-5 mb-2 flex flex-col gap-1">
      <div
        data-profile
        data-elev={JSON.stringify(profile.elev)}
        data-mapf={JSON.stringify(profile.mapF)}
        role="img"
        aria-label={`Elevation profile of the trail, from the Southern Terminus to the Northern Terminus. Highest point Mount Whitney, 4,421 metres (14,505 feet).`}
        class="relative h-14 cursor-crosshair touch-none select-none"
      >
        <div data-profile-window class="absolute inset-y-0 hidden rounded-sm bg-heading/10 md:hidden!"></div>
        <svg
          aria-hidden="true"
          viewBox={`0 0 ${PROFILE_W} ${PROFILE_H}`}
          preserveAspectRatio="none"
          class="absolute inset-0 h-full w-full overflow-visible"
        >
          <path d={profile.area} fill="#313244" opacity="0.7"></path>
          <path d={profile.line} fill="none" stroke="#6c7086" stroke-width="1.25" vector-effect="non-scaling-stroke"></path>
          {
            profileTicks.map((t) => (
              <line
                x1={t * PROFILE_W}
                x2={t * PROFILE_W}
                y1="0"
                y2={PROFILE_H}
                stroke="#45475a"
                stroke-dasharray="2 3"
                vector-effect="non-scaling-stroke"
              />
            ))
          }
        </svg>
        {/* Selected section, filled in its colour; revealed left to right by animating the clip. */}
        <div data-profile-fill class="pointer-events-none absolute inset-0 [clip-path:inset(0_100%_0_0)]">
          <svg
            aria-hidden="true"
            viewBox={`0 0 ${PROFILE_W} ${PROFILE_H}`}
            preserveAspectRatio="none"
            class="absolute inset-0 h-full w-full"
          >
            <path d={profile.area} fill="var(--sec-color, #038285)" opacity="0.35"></path>
            <path
              d={profile.line}
              fill="none"
              stroke="var(--sec-color, #038285)"
              stroke-width="2"
              vector-effect="non-scaling-stroke"></path>
          </svg>
        </div>
        {/* High point, labelled Mount Whitney (the trail's side trip to the summit). */}
        <span
          aria-hidden="true"
          class="pointer-events-none absolute size-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-heading"
          style={`left: ${(profile.peak.x * 100).toFixed(2)}%; top: ${(profile.peak.y * 100).toFixed(2)}%`}></span>
        <span
          aria-hidden="true"
          class="pointer-events-none absolute -top-1 -translate-y-full text-[0.7rem] leading-none whitespace-nowrap text-muted"
          style={`left: calc(${(profile.peak.x * 100).toFixed(2)}% + 6px)`}
        >
          Mount Whitney · <span data-unit="metric">4,421 m</span><span data-unit="imperial">14,505 ft</span>
        </span>
        {/* Scrub marker: a thin line with a dot on the profile. */}
        <div data-profile-cursor aria-hidden="true" class="pointer-events-none absolute inset-y-0 hidden w-px bg-heading/70">
          <span
            data-profile-dot
            class="absolute left-1/2 size-2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-heading shadow-[0_0_0_3px_rgb(30_30_46)]"
          ></span>
        </div>
      </div>
      <div aria-hidden="true" class="flex justify-between text-[0.75rem] text-muted">
        <span>Southern Terminus</span>
        <span>Northern Terminus</span>
      </div>
    </div>

    {/*
      On phones the strip scrolls sideways: it runs edge to edge (-mx-5) but snaps with the page's 20px gap
      (scroll-px-5), hides the native scrollbar, and gets ‹ › arrows plus a timeline-style progress bar below,
      both driven by the script at the bottom.
    */}
    <div data-strip class="relative -mx-5 md:mx-0">
      <ul
        data-strip-list
        class="m-0 flex list-none scroll-px-5 gap-2 overflow-x-auto px-5 pt-1 pb-1 [scrollbar-width:none] snap-x snap-mandatory md:scroll-px-0 md:px-0 [&::-webkit-scrollbar]:hidden"
      >
      {
        photos.map((ph, i) => (
          <li
            data-pct-photo
            data-from={ph.from}
            data-to={ph.to}
            data-colour={ph.colour}
            style={`--c: ${ph.colour}`}
            data-main-metric={`${ph.section} · ${ph.dist.metric}`}
            data-main-imperial={`${ph.section} · ${ph.dist.imperial}`}
            data-route={ph.route}
            data-section={ph.section}
            data-pfrom={ph.pFrom}
            data-pto={ph.pTo}
            data-wfrom={ph.wFrom}
            data-wto={ph.wTo}
            class="group @container w-[5.5rem] shrink-0 snap-start sm:w-auto sm:min-w-[3.5rem] sm:flex-1"
          >
            <figure class="m-0 flex flex-col gap-1">
              {ph.src ? (
                <button
                  type="button"
                  data-photo-open={i}
                  aria-haspopup="dialog"
                  aria-label={`Enlarge photo: ${ph.section}`}
                  class="block cursor-zoom-in overflow-hidden rounded-lg border border-line transition-colors group-hover:border-(--c) group-data-active:border-(--c)"
                >
                  <Image
                    src={ph.src}
                    alt={ph.alt}
                    widths={[160, 240, 360]}
                    sizes="90px"
                    class="block aspect-square w-full object-cover transition-transform duration-300 group-hover:scale-[1.06] motion-reduce:transition-none"
                  />
                </button>
              ) : (
                <div
                  tabindex="0"
                  aria-label={`${ph.section}: photo to come`}
                  class="flex aspect-square items-center justify-center rounded-lg border border-dashed border-line-strong text-[0.8rem] text-muted transition-colors group-hover:border-(--c) group-hover:text-(--c) group-data-active:border-solid group-data-active:border-(--c) group-data-active:text-(--c)"
                >
                  +
                </div>
              )}
              {/* Narrow tiles (container query) show the short name, e.g. "Wash."; the readout has the full one. */}
              <figcaption class="truncate text-center text-[0.8rem] text-muted transition-colors group-hover:text-heading group-data-active:text-(--c)">
                {'short' in ph && ph.short ? (
                  <>
                    <span class="hidden @[4.875rem]:inline">{ph.section}</span>
                    <span class="@[4.875rem]:hidden">{ph.short}</span>
                  </>
                ) : (
                  ph.section
                )}
              </figcaption>
            </figure>

            {ph.src && (
              <dialog
                data-photo-dialog={i}
                aria-label={ph.section}
                class="m-auto max-h-[calc(100dvh-2rem)] w-[min(1200px,calc(100vw-2rem))] overflow-hidden rounded-[14px] border border-line bg-mantle p-0 text-text shadow-[0_30px_80px_rgb(0_0_0/0.6)] backdrop:bg-crust/80 backdrop:backdrop-blur-sm"
              >
                <figure class="m-0 flex flex-col">
                  <Image
                    src={ph.src}
                    alt={ph.alt}
                    widths={[960, 1600, 2400]}
                    sizes="90vw"
                    class="block h-auto max-h-[calc(100dvh-7rem)] w-full bg-crust object-contain"
                  />
                  <figcaption class="flex items-center justify-between gap-4 px-5 py-2 text-[0.8rem]">
                    <span>
                      <span class="text-accent">//</span> {ph.section}{' '}
                      <span class="text-muted">
                        · <span data-unit="metric">{ph.dist.metric}</span>
                        <span data-unit="imperial">{ph.dist.imperial}</span>
                      </span>
                      <span class="block pl-[3ch] text-muted sm:inline sm:pl-0">
                        <span class="hidden sm:inline">{" · "}</span>
                        {ph.route}
                      </span>
                    </span>
                    <button
                      type="button"
                      data-photo-close
                      aria-label="Close"
                      class="-mr-3 flex size-[44px] shrink-0 cursor-pointer items-center justify-center rounded-md text-muted hover:text-accent"
                    >
                      ✕
                    </button>
                  </figcaption>
                </figure>
              </dialog>
            )}
          </li>
        ))
      }
      </ul>

      {/* ‹ › arrows: shown only while there's more of the strip off-screen in that direction. */}
      {
        [
          { dir: 'prev', label: 'Earlier sections', side: 'left-0 bg-linear-to-r', path: 'M15 18l-6-6 6-6' },
          { dir: 'next', label: 'Later sections', side: 'right-0 bg-linear-to-l', path: 'M9 18l6-6-6-6' },
        ].map((a) => (
          <div
            data-strip-arrow={a.dir}
            class={`pointer-events-none absolute top-1 flex h-[5.5rem] w-14 items-center justify-center from-bg via-bg/80 to-transparent opacity-0 transition-opacity duration-300 data-show:pointer-events-auto data-show:opacity-100 md:hidden ${a.side}`}
          >
            <button
              type="button"
              aria-label={a.label}
              tabindex="-1"
              class="flex size-9 cursor-pointer items-center justify-center rounded-full border border-line bg-mantle/90 text-heading shadow-[0_4px_12px_rgb(0_0_0/0.4)]"
            >
              <svg
                aria-hidden="true"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d={a.path}></path>
              </svg>
            </button>
          </div>
        ))
      }
    </div>

    {/*
      Readout: "// Desert · km 0–1,130 · Southern Terminus → Kennedy Meadows" on one line on wider screens; on phones the
      route goes on a second line so nothing wraps mid-phrase. Two lines are always reserved on phones so the
      page doesn't jump.
    */}
    <p data-pct-readout aria-live="polite" class="m-0 min-h-[3.4em] text-[0.8rem] leading-[1.7] text-muted sm:min-h-[1.7em]">
      <span data-pct-readout-mark class="text-accent transition-colors">//</span>{" "}
      <span data-readout-hint>
        <span class="sm:hidden">Tap a photo to trace its section</span>
        <span class="hidden sm:inline">Point at a photo to trace its section on the map</span>
      </span>
      <span data-readout-main hidden></span>
      <span data-readout-route hidden class="pl-[3ch] data-show:block sm:pl-0 sm:data-show:inline">
        <span class="hidden sm:inline">{" · "}</span>
        <span data-readout-route-text></span>
      </span>
    </p>
  </div>

  <div class="flex flex-col gap-6">
    <dl class="m-0 grid grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-4 lg:grid-cols-2 xl:grid-cols-4">
      {
        pct.stats.map((s) => (
          <div class="flex flex-col-reverse">
            <dt class="text-[0.8rem] text-muted">{s.label}</dt>
            <dd class="m-0 text-[1.6rem] leading-tight font-bold whitespace-nowrap text-accent">
              {'miles' in s && s.miles ? (
                <>
                  <span data-unit="metric">{distance(s.miles, 'metric')}</span>
                  <span data-unit="imperial">{distance(s.miles, 'imperial')}</span>
                </>
              ) : (
                'value' in s && s.value
              )}
            </dd>
          </div>
        ))
      }
    </dl>
    {/* The full list of trail numbers lives on its own page (src/pages/trail-stats.astro). */}
    <a href="/trail-stats/" class="inline-flex min-h-[44px] items-center gap-2 self-start font-semibold">
      {pct.moreStats.link} <span aria-hidden="true" class="text-accent">→</span>
    </a>
  </div>
</section>

<script>
  // Selecting a photo lights up just that section of the map in its colour, filling up from the section's
  // start to its end, and shows its details in the readout.
  // - Hover or keyboard focus selects a photo, unless one is pinned.
  // - A click or tap pins it: hovering other photos (or the map) then leaves it alone. Clicking another photo
  //   pins that one; clicking anywhere else on the page unpins and clears.
  // - With nothing pinned, hovering the map switches back to its own Campo-to-cursor colouring.
  const done = document.querySelector<SVGGElement>('[data-pct-done]');
  const section = document.querySelector<SVGGElement>('[data-pct-section]');
  const startMarker = document.querySelector<SVGCircleElement>('[data-pct-start]');
  const endMarker = document.querySelector<SVGCircleElement>('[data-pct-end]');
  const readoutMark = document.querySelector<HTMLElement>('[data-pct-readout-mark]');
  const readoutHint = document.querySelector<HTMLElement>('[data-readout-hint]');
  const readoutMain = document.querySelector<HTMLElement>('[data-readout-main]');
  const readoutRoute = document.querySelector<HTMLElement>('[data-readout-route]');
  const readoutRouteText = document.querySelector<HTMLElement>('[data-readout-route-text]');
  const profileEl = document.querySelector<HTMLElement>('[data-profile]');
  const profileFill = document.querySelector<HTMLElement>('[data-profile-fill]');
  const profileCursor = document.querySelector<HTMLElement>('[data-profile-cursor]');
  const profileDot = document.querySelector<HTMLElement>('[data-profile-dot]');
  const profileWindow = document.querySelector<HTMLElement>('[data-profile-window]');
  const imperial = () => document.documentElement.dataset.units === 'imperial';
  // What the readout shows: a section, a point on the profile, or (null) the hint.
  let readoutState: { main: () => string; route: string; colour: string } | null = null;
  const renderReadout = () => {
    const on = !!readoutState;
    if (readoutHint) readoutHint.hidden = on;
    if (readoutMain) {
      readoutMain.hidden = !on;
      readoutMain.textContent = readoutState?.main() ?? '';
    }
    readoutRoute?.toggleAttribute('hidden', !on || !readoutState?.route);
    readoutRoute?.toggleAttribute('data-show', on && !!readoutState?.route);
    if (readoutRouteText) readoutRouteText.textContent = readoutState?.route ?? '';
    if (readoutMark) readoutMark.style.color = readoutState?.colour ?? '';
  };
  const tiles = document.querySelectorAll<HTMLElement>('[data-pct-photo]');
  let active: HTMLElement | undefined;
  let pinned: HTMLElement | undefined;
  let endTimer: number | undefined;

  const showReadout = () => {
    const tile = active;
    readoutState = tile
      ? {
          main: () => (imperial() ? tile.dataset.mainImperial : tile.dataset.mainMetric) ?? '',
          route: tile.dataset.route ?? '',
          colour: tile.dataset.colour ?? '',
        }
      : null;
    renderReadout();
  };

  // Profile fill: reveal the section's stretch of the profile, left to right, in step with the map's fill.
  const fillProfile = (pFrom: number, pTo: number, colour: string, seconds: number) => {
    if (!profileFill) return;
    profileFill.style.setProperty('--sec-color', colour);
    profileFill.style.transition = 'none';
    profileFill.style.clipPath = `inset(0 ${(100 - pFrom * 100).toFixed(2)}% 0 ${(pFrom * 100).toFixed(2)}%)`;
    getComputedStyle(profileFill).clipPath;
    const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    profileFill.style.transition = smooth ? `clip-path ${seconds.toFixed(2)}s ease-out` : 'none';
    profileFill.style.clipPath = `inset(0 ${(100 - pTo * 100).toFixed(2)}% 0 ${(pFrom * 100).toFixed(2)}%)`;
  };
  const clearProfile = () => {
    if (!profileFill) return;
    profileFill.style.transition = 'none';
    profileFill.style.clipPath = 'inset(0 100% 0 0)';
  };

  const resetMarkers = () => {
    window.clearTimeout(endTimer);
    startMarker?.removeAttribute('data-highlight');
    startMarker?.removeAttribute('data-tint');
    endMarker?.removeAttribute('data-tint');
  };

  const clear = () => {
    pinned = undefined;
    if (!active) return;
    active = undefined;
    tiles.forEach((t) => t.removeAttribute('data-active'));
    section?.removeAttribute('data-active');
    resetMarkers();
    clearProfile();
    showReadout();
  };

  const select = (tile: HTMLElement) => {
    if (tile === active) return; // already selected: keep it, don't restart the fill
    active = tile;
    tiles.forEach((t) => t.toggleAttribute('data-active', t === tile));
    const from = Number(tile.dataset.from ?? 0);
    const to = Number(tile.dataset.to ?? 0);
    const colour = tile.dataset.colour ?? '';
    const seconds = 0.5 + (to - from) * 1.5; // longer sections take a little longer to fill
    done?.style.setProperty('--done', '0'); // hide the map-hover colouring while a section is shown

    // Markers take the section colour: Start (a single point) rings the start marker; a section that begins
    // at Campo tints the start marker straight away; one that reaches the very end tints the end marker
    // once the fill gets there.
    resetMarkers();
    startMarker?.style.setProperty('--marker-color', colour);
    endMarker?.style.setProperty('--marker-color', colour);
    startMarker?.toggleAttribute('data-highlight', to <= from);
    startMarker?.toggleAttribute('data-tint', from === 0);
    if (to >= 1) endTimer = window.setTimeout(() => endMarker?.toggleAttribute('data-tint', true), seconds * 1000);

    if (section) {
      section.style.setProperty('--sec-color', colour);
      section.style.setProperty('--sec-from', String(from));
      // Restart the fill: jump back to zero length without animating, then animate to the section's length.
      section.style.transition = 'none';
      section.style.setProperty('--sec-len', '0');
      getComputedStyle(section).getPropertyValue('--sec-len');
      section.style.transition = '';
      section.style.setProperty('--sec-duration', `${seconds.toFixed(2)}s`);
      section.toggleAttribute('data-active', to > from);
      section.style.setProperty('--sec-len', String(Math.max(0, to - from)));
    }
    fillProfile(Number(tile.dataset.pfrom ?? 0), Number(tile.dataset.pto ?? 0), colour, seconds);
    showReadout();
  };

  tiles.forEach((tile) => {
    const preview = () => {
      if (!pinned) select(tile);
    };
    tile.addEventListener('pointerenter', preview);
    tile.addEventListener('focusin', preview);
    // Click or tap pins the photo.
    tile.addEventListener('pointerdown', () => {
      pinned = tile;
      select(tile);
    });
    tile.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        pinned = tile;
        select(tile);
      }
    });
  });
  document.addEventListener('unitschange', renderReadout);
  // The map asks before drawing its own colouring: a pinned section wins, otherwise the section is cleared.
  document.addEventListener('pct:map-pointer', (e) => {
    if (pinned) e.preventDefault();
    else clear();
  });
  // A click anywhere else (not a photo, the strip arrows, a photo dialog or the units switch) unpins and clears.
  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    if (!target?.closest('[data-pct-photo], [data-strip-arrow], [data-profile], dialog, [data-units-toggle]')) clear();
  });

  // Touching or clicking the map itself counts as "elsewhere": it unpins, so the map can take over.
  document.addEventListener('pct:map-press', clear);

  // Phone strip: show ‹ › arrows while there's more off-screen in that direction, and fill the progress bar.
  const list = document.querySelector<HTMLElement>('[data-strip-list]');
  const prevArrow = document.querySelector<HTMLElement>('[data-strip-arrow="prev"]');
  const nextArrow = document.querySelector<HTMLElement>('[data-strip-arrow="next"]');

  let stripTicking = false;
  const updateStrip = () => {
    stripTicking = false;
    if (!list) return;
    const overflow = list.scrollWidth - list.clientWidth > 1;
    prevArrow?.toggleAttribute('data-show', overflow && list.scrollLeft > 4);
    nextArrow?.toggleAttribute('data-show', overflow && list.scrollLeft + list.clientWidth < list.scrollWidth - 4);
    // Band on the elevation profile covering the photos currently on screen (phones only).
    if (profileWindow) {
      const box = list.getBoundingClientRect();
      const seen = [...tiles].filter((t) => {
        const r = t.getBoundingClientRect();
        // Counts as on screen when at least half of the photo is visible.
        return Math.min(r.right, box.right) - Math.max(r.left, box.left) >= r.width / 2;
      });
      profileWindow.hidden = !overflow || !seen.length;
      if (seen.length) {
        const from = Math.min(...seen.map((t) => Number(t.dataset.wfrom ?? 0)));
        const to = Math.max(...seen.map((t) => Number(t.dataset.wto ?? 0)));
        profileWindow.style.left = `${(from * 100).toFixed(2)}%`;
        profileWindow.style.width = `${(Math.max(to - from, 0.01) * 100).toFixed(2)}%`;
      }
    }
  };
  const onStripChange = () => {
    if (!stripTicking) {
      stripTicking = true;
      requestAnimationFrame(updateStrip);
    }
  };
  list?.addEventListener('scroll', onStripChange, { passive: true });
  window.addEventListener('resize', onStripChange);
  updateStrip();
  // Arrows scroll by about three photos.
  const scrollStrip = (direction: number) => {
    if (!list) return;
    const step = (tiles[0]?.getBoundingClientRect().width ?? 88) + 8;
    const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    list.scrollBy({ left: direction * step * 3, behavior: smooth ? 'smooth' : 'auto' });
  };
  prevArrow?.querySelector('button')?.addEventListener('click', () => scrollStrip(-1));
  nextArrow?.querySelector('button')?.addEventListener('click', () => scrollStrip(1));

  // The elevation profile and the map are linked both ways:
  // - Scrubbing the profile moves its marker, traces the map up to that point and shows the distance,
  //   elevation and section in the readout. Pressing on it unpins a pinned photo (like the map); plain mouse
  //   hovering leaves a pinned photo alone.
  // - Moving over the map (pct:map-trace from PctMap) moves the profile marker to the same point on the trail.
  if (profileEl) {
    const elev: number[] = JSON.parse(profileEl.dataset.elev ?? '[]');
    const mapF: number[] = JSON.parse(profileEl.dataset.mapf ?? '[]');
    const maxElev = Math.max(...elev);
    const sectionTiles = [...tiles].slice(1, -1); // the stretches, not the two terminuses
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');

    // Show sample i (0 … n-1) on the profile: marker position, the profile coloured PCT teal from Campo up to
    // that point (matching the map's colouring, and staying put like it does), plus the readout.
    const showPoint = (i: number) => {
      const x = i / (elev.length - 1);
      const metres = elev[i];
      if (profileCursor && profileDot) {
        profileCursor.hidden = false;
        profileCursor.style.left = `${(x * 100).toFixed(2)}%`;
        profileDot.style.top = `${(100 - (metres / maxElev) * 92).toFixed(1)}%`;
      }
      if (profileFill) {
        profileFill.style.setProperty('--sec-color', '#038285');
        profileFill.style.transition = 'none';
        profileFill.style.clipPath = `inset(0 ${(100 - x * 100).toFixed(2)}% 0 0)`;
      }
      const miles = x * 2650;
      const here = sectionTiles.find((t) => x >= Number(t.dataset.pfrom) && x <= Number(t.dataset.pto));
      readoutState = {
        main: () =>
          imperial() ? `mi ${fmt(miles)} · ${fmt(metres * 3.28084)} ft` : `km ${fmt(miles * 1.609344)} · ${fmt(metres)} m`,
        route: here?.dataset.section ?? '',
        colour: '',
      };
      renderReadout();
    };
    const hidePoint = () => {
      if (profileCursor) profileCursor.hidden = true;
    };

    // Profile → map. Pointer moves are handled at most once per frame.
    const scrub = (e: PointerEvent) => {
      if (!elev.length) return;
      const box = profileEl.getBoundingClientRect();
      const x = Math.min(1, Math.max(0, (e.clientX - box.left) / box.width));
      const i = Math.round(x * (elev.length - 1));
      done?.style.setProperty('--done', String(mapF[i] ?? 0));
      showPoint(i);
    };
    let pendingScrub: PointerEvent | undefined;
    profileEl.addEventListener('pointerdown', (e) => {
      clear();
      scrub(e);
    });
    profileEl.addEventListener('pointermove', (e) => {
      if (pinned) return;
      if (active) clear();
      if (!pendingScrub) {
        requestAnimationFrame(() => {
          if (pendingScrub) scrub(pendingScrub);
          pendingScrub = undefined;
        });
      }
      pendingScrub = e;
    });
    profileEl.addEventListener('pointerleave', hidePoint);

    // Map → profile: find the sample whose position on the map's route is nearest (mapF only increases, so a
    // binary search finds it).
    document.addEventListener('pct:map-trace', (e) => {
      const f = (e as CustomEvent<number>).detail;
      let lo = 0;
      let hi = mapF.length - 1;
      while (lo < hi) {
        const mid = (lo + hi) >> 1;
        if (mapF[mid] < f) lo = mid + 1;
        else hi = mid;
      }
      const i = lo > 0 && f - mapF[lo - 1] < mapF[lo] - f ? lo - 1 : lo;
      showPoint(i);
    });
    document.addEventListener('pct:map-leave', hidePoint);
  }

  // Click a photo to see it full size.
  document.querySelectorAll<HTMLButtonElement>('[data-photo-open]').forEach((button) => {
    const dialog = document.querySelector<HTMLDialogElement>(`[data-photo-dialog="${button.dataset.photoOpen}"]`);
    if (!dialog) return;
    button.addEventListener('click', () => dialog.showModal());
    dialog.querySelector('[data-photo-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  });
</script>
